# Copy to .env and fill in. No spaces around "=".

# --- Auth ---------------------------------------------------------------
# none   : no auth. Only for local use on 127.0.0.1.
# bearer : clients send "Authorization: Bearer <token>" (Claude Code, n8n, scripts).
# github : GitHub OAuth. Required for claude.ai custom connectors.
AUTH_MODE=bearer

# bearer mode: one or more tokens, comma separated. Generate with: openssl rand -hex 32
# github mode: optional, enables the REST endpoint /v1/classify for non-MCP clients.
API_TOKENS=

# github mode only
BASE_URL=https://laya.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USERS=
# Signs tokens and encrypts OAuth state on disk. Do not change it after the first start.
APP_SECRET=

# --- Model --------------------------------------------------------------
# multilingual, english, typed-decisions. Each loaded checkpoint needs about 2.5-3 GB of RAM.
LAYA_CHECKPOINTS=multilingual
# CPU threads for inference. Keep it below the number of cores on shared hosts.
OMP_NUM_THREADS=2

# --- Behaviour ----------------------------------------------------------
MAX_ITEMS=50
LOW_CONFIDENCE=0.7
# Which field the threshold applies to when no calibration is loaded:
# answer_confidence (probability of the chosen answer) or confidence (stricter)
LOW_CONFIDENCE_FIELD=answer_confidence
# Optional: JSON file with temperatures, see examples/calibration.example.json
CALIBRATION_PATH=

# --- Server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DATA_DIR=/data
HF_HOME=/data/hf
LOG_LEVEL=INFO
